<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>xiaoliang</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f;
      --text: #f0f0f5;
      --text-muted: #8a8a95;
      --text-dim: #5a5a65;
      --accent: #c9a96e;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }

    .content {
      max-width: 640px;
      text-align: center;
    }

    .name {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 48px;
    }

    .tagline {
      font-family: 'Noto Serif SC', serif;
      font-size: 20px;
      color: var(--text-muted);
      line-height: 1.8;
      margin-bottom: 64px;
    }

    .divider {
      width: 32px;
      height: 1px;
      background: var(--accent);
      margin: 0 auto 48px;
    }

    .section-title {
      font-size: 10px;
      font-weight: 500;
      letter-cier-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 24px;
    }

    .writing-list { list-style: none; }

    .writing-list li { margin-bottom: 16px; }

    .writing-list a {
      display: inline-flex;
      align-items: baseline;
      gap: 12px;
      font-size: 15px;
      color: var(--text);
      text-decoration: none;
      padding: 8px 0;
      position: relative;
      transition: color 0.3s ease;
    }

    .writing-list a::after {
      content: '';
      position: absolute;
      bottom: 6px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--accent);
      transition: width 0.4s ease;
    }

    .writing-list a:hover {
      color: var(--accent);
    }

    .writing-list a:hover::after {
      width: 100%;
    }

    .writing-list .meta {
      font-size: 12px;
      color: var(--text-dim);
      font-weight: 300;
    }

    /* ===== 通用展开按钮 ===== */
    .toggle-btn {
      background: none;
      border: 1px solid var(--text-dim);
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 10px 20px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 64px;
    }

    .toggle-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .toggle-btn svg {
      width: 12px;
      height: 12px;
      transition: transform 0.3s ease;
    }

    .toggle-btn.open svg {
      transform: rotate(90deg);
    }

    /* ===== 照片墙 ===== */
    .photo-wall {
      display: none;
      margin-top: 24px;
    }

    .photo-wall.open {
      display: block;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      margin-top: 24px;
    }

    .photo-grid a {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      position: relative;
    }

    .photo-grid img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease, filter 0.5s ease;
      filter: grayscale(30%);
    }

    .photo-grid a:hover img {
      transform: scale(1.05);
      filter: grayscale(0%);
    }

    .photo-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 15, 0.95);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      cursor: zoom-out;
    }

    .photo-lightbox.open {
      display: flex;
    }

    .lightbox-img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .lightbox-img.loaded {
      opacity: 1;
    }

    .lightbox-close {
      position: absolute;
      top: 24px;
      right: 24px;
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 24px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: color 0.3s;
    }

    .lightbox-close:hover { color: var(--text); }

    /* scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--text-dim); border-radius: 2px; }

    @media (max-width: 640px) {
      .tagline { font-size: 18px; }
      .photo-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <!-- 照片灯箱 -->
  <div class="photo-lightbox" id="lightbox" onclick="closeLightbox(event)">
    <button class="lightbox-close" onclick="closeLightbox(event)">✕</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="">
  </div>

  <div class="content">
    <p class="name">xiaoliang</p>
    <p class="tagline">INFP，躯体化，318 是人生目标。</p>
    <div class="divider"></div>

    <p class="section-title">文章</p>
    <ul class="writing-list">
      <li>
        <a href="experience.html">
          抑郁
          <span class="meta">2026</span>
        </a>
      </li>
    </ul>

    <!-- 照片墙 -->
    <button class="toggle-btn" id="photo-btn" onclick="toggleSection('photo')">
      <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
      照片
    </button>
    <div class="photo-wall" id="photo-wall">
      <div class="photo-grid" id="photo-grid"></div>
    </div>

  </div>

  <script>
    /* ===== 相册灯箱 ===== */
    const photos = [
      'https://picsum.photos/800/800?random=10',
      'https://picsum.photos/800/800?random=11',
      'https://picsum.photos/800/800?random=12',
      'https://picsum.photos/800/800?random=13',
      'https://picsum.photos/800/800?random=14',
      'https://picsum.photos/800/800?random=15',
      'https://picsum.photos/800/800?random=16',
      'https://picsum.photos/800/800?random=17',
      'https://picsum.photos/800/800?random=18',
    ];

    function toggleSection(name) {
      const sec = document.getElementById(name + '-section');
      const btn = document.getElementById(name + '-btn');
      sec.classList.toggle('open');
      btn.classList.toggle('open');
      if (name === 'photo' && sec.classList.contains('open') && document.getElementById('photo-grid').children.length === 0) {
        renderPhotos();
      }
    }

    function renderPhotos() {
      const grid = document.getElementById('photo-grid');
      photos.forEach(src => {
        const a = document.createElement('a');
        a.href = '#';
        a.onclick = () => openLightbox(src);
        const img = document.createElement('img');
        img.src = src;
        img.loading = 'lazy';
        a.appendChild(img);
        grid.appendChild(a);
      });
    }

    function openLightbox(src) {
      const lb  = document.getElementById('lightbox');
      const img = document.getElementById('lightbox-img');
      img.classList.remove('loaded');
      img.src = src;
      img.onload = () => img.classList.add('loaded');
      lb.classList.add('open');
    }

    function closeLightbox(e) {
      if (e.target === e.currentTarget || e.target.classList.contains('lightbox-close')) {
        document.getElementById('lightbox').classList.remove('open');
      }
    }

    /* 键盘关闭灯箱 */
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeLightbox({ target: document.getElementById('lightbox'), currentTarget: document.getElementById('lightbox') });
    });
  </script>
</body>
</html>
